VITE_FIREBASE_RTDB_INSOLE_PATH=

# External HTTP API Configuration (for Axios client)
VITE_API_BASE_URL=
# Optional screening analysis endpoint path or URL if an external analysis service is active
VITE_SCREENING_ENDPOINT=
